# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Rahasia! Hanya dipakai di server (API & MCP untuk agent)
SUPABASE_SECRET_KEY=sb_secret_...

# Kunci yang dipakai agent (Hermes, Claude, dll) untuk akses /api/v1 dan /api/mcp.
# Buat string acak panjang, misal: openssl rand -hex 32
AGENT_API_KEY=ganti-dengan-string-acak-panjang

# Opsional: kunci di URL untuk custom connector claude.ai → https://<domain>/api/mcp/<MCP_URL_KEY>
# Minimal 32 karakter (openssl rand -hex 32). Kosongkan untuk menonaktifkan.
MCP_URL_KEY=

# URL publik aplikasi (untuk link dokumen yang dikirim agent)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Bot WhatsApp bawaan (opsional, lihat AGENT.md → "Bot WhatsApp") ──
# Claude API key dari https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium            # low = lebih cepat & hemat, high = lebih teliti
# Meta for Developers → app WhatsApp
WHATSAPP_TOKEN=                   # token permanen (System User)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=              # App settings → Basic → App secret
WHATSAPP_VERIFY_TOKEN=            # string bebas, sama dengan yang diisi di Meta saat daftar webhook
WHATSAPP_ALLOWED_NUMBERS=6281234567890,6289876543210
# WHATSAPP_API_VERSION=v23.0
