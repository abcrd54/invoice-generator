# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Rahasia! Hanya dipakai di server (API & MCP untuk agent)
SUPABASE_SECRET_KEY=sb_secret_...

# Kunci yang dipakai agent (Hermes, Claude, dll) untuk akses /api/v1 dan /api/mcp.
# Buat string acak panjang, misal: openssl rand -hex 32
AGENT_API_KEY=ganti-dengan-string-acak-panjang

# URL publik aplikasi (untuk link dokumen yang dikirim agent)
NEXT_PUBLIC_APP_URL=http://localhost:3000
